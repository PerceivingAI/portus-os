{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portusos.local/oss/system-package-inventory.schema.json",
  "title": "PortusOS candidate system-package inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "package_lock_sha256", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "package_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "source_class", "repository", "licenses", "verification"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source_class": {"enum": ["official-artix", "portus-owned", "approved-external", "validation-only", "hardware-selected"]},
          "repository": {"type": ["string", "null"]},
          "licenses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "verification": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
