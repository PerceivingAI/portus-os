{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portusos.local/schemas/validation-report.schema.json",
  "title": "PortusOS validation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "iso_filename", "iso_sha256", "source_revision", "validation_authority_revision", "reference_environment_ref", "minimum_environment_ref", "started_at", "ended_at", "status", "counts", "tests", "imported_evidence", "known_limitations_ref", "redactions_ref", "accepted_at"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "iso_filename": {"type": "string", "minLength": 1},
    "iso_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "validation_authority_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reference_environment_ref": {"const": "environment/reference.json"},
    "minimum_environment_ref": {"const": "environment/minimum.json"},
    "started_at": {"type": "string", "minLength": 1},
    "ended_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["accepted", "rejected", "incomplete"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "blocked", "not_run"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "not_run": {"type": "integer", "minimum": 0}
      }
    },
    "tests": {
      "type": "array",
      "minItems": 38,
      "maxItems": 38,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "status", "result_ref"],
        "properties": {
          "test_id": {"type": "string", "pattern": "^ISO-(0[1-9]|[12][0-9]|3[0-8])$"},
          "status": {"enum": ["pass", "fail", "blocked", "not_run"]},
          "result_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "imported_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_safe", "update", "protected_api"],
      "properties": {
        "host_safe": {"type": "array", "items": {"type": "string"}},
        "update": {"type": "array", "items": {"type": "string"}},
        "protected_api": {"type": "array", "items": {"type": "string"}}
      }
    },
    "known_limitations_ref": {"type": "string", "minLength": 1},
    "redactions_ref": {"const": "redactions.json"},
    "accepted_at": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "accepted"}}, "required": ["status"]},
      "then": {"properties": {"accepted_at": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["rejected", "incomplete"]}}, "required": ["status"]},
      "then": {"properties": {"accepted_at": {"type": "null"}}}
    }
  ]
}
