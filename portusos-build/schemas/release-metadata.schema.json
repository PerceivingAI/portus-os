{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portusos.local/schemas/release-metadata.schema.json",
  "title": "PortusOS release metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_class", "release_id", "version", "rc_number", "source_tag", "validated_candidate_id", "promoted_from_candidate_id", "published_iso_filename", "iso_sha256", "build_metadata_ref", "validation_report_ref", "release_policy_sha256", "verification_method", "checksum_signature_ref", "signing_key_fingerprint", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "release_class": {"enum": ["public_rc", "public_final"]},
    "release_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "rc_number": {"type": ["integer", "null"], "minimum": 1},
    "source_tag": {"type": "string", "minLength": 1},
    "validated_candidate_id": {"type": "string", "minLength": 1},
    "promoted_from_candidate_id": {"type": ["string", "null"]},
    "published_iso_filename": {"type": "string", "minLength": 1},
    "iso_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build_metadata_ref": {"type": "string", "minLength": 1},
    "validation_report_ref": {"type": "string", "minLength": 1},
    "release_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification_method": {"const": "openssh-sshsig-ed25519"},
    "checksum_signature_ref": {"const": "SHA256SUMS.sig"},
    "signing_key_fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/=]+$"},
    "created_at": {"type": "string", "minLength": 1}
  }
}
