{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portusos.local/schemas/package-lock.schema.json",
  "title": "PortusOS resolved package/source lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_manifest_sha256", "generated_at", "artix", "resolved"],
  "properties": {
    "schema_version": {"const": 1},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at": {"type": "string", "minLength": 1},
    "artix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "repositories"],
      "properties": {
        "architecture": {"const": "x86_64"},
        "repositories": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "resolved": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_class", "artifacts"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_class": {"enum": ["official-artix", "portus-owned", "approved-external", "validation-only", "hardware-selected"]},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["identity", "version", "licenses", "verification"],
              "properties": {
                "identity": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1},
                "repository": {"type": ["string", "null"]},
                "licenses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
                "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                "verification": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
