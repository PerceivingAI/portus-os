{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portusos.local/schemas/package-source.schema.json",
  "title": "PortusOS package/source contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_policies", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "source_policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official-artix", "portus-owned", "approved-external", "validation-only", "hardware-selected"],
      "properties": {
        "official-artix": {"$ref": "#/$defs/sourcePolicy"},
        "portus-owned": {"$ref": "#/$defs/sourcePolicy"},
        "approved-external": {"$ref": "#/$defs/sourcePolicy"},
        "validation-only": {"$ref": "#/$defs/sourcePolicy"},
        "hardware-selected": {"$ref": "#/$defs/sourcePolicy"}
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "source_class", "required_for_first_iso", "profile"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "source_class": {"enum": ["official-artix", "portus-owned", "approved-external", "validation-only", "hardware-selected"]},
          "required_for_first_iso": {"type": "boolean"},
          "profile": {"type": "string", "minLength": 1},
          "package": {"$ref": "#/$defs/resolvedPackage"},
          "install_contract": {"type": "string", "minLength": 1},
          "component_contract": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification", "installation_owner", "update_owner", "failure_behavior", "public_redistribution"],
      "properties": {
        "verification": {"type": "string", "minLength": 1},
        "installation_owner": {"type": "string", "minLength": 1},
        "update_owner": {"type": "string", "minLength": 1},
        "failure_behavior": {"type": "string", "minLength": 1},
        "public_redistribution": {"enum": ["pending-review", "approved", "not-applicable"]}
      }
    },
    "resolvedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "names", "unresolved_reason", "required_gate"],
      "properties": {
        "resolution": {"enum": ["locked", "linux-verified", "owner-decision", "generated"]},
        "names": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "pattern": "^[^\\s]+$"},
          "uniqueItems": true
        },
        "unresolved_reason": {"type": ["string", "null"], "minLength": 1},
        "required_gate": {"type": "string", "minLength": 1}
      }
    }
  }
}
