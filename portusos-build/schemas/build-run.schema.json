{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portusos.local/schemas/build-run.schema.json",
  "title": "PortusOS build iteration record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "label",
    "status",
    "started_at",
    "finished_at",
    "configuration",
    "source",
    "outer_host",
    "preflight",
    "steps",
    "artifact",
    "failure",
    "records"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["development", "release_candidate"]},
    "label": {"type": ["string", "null"]},
    "status": {"enum": ["running", "blocked", "failed", "succeeded"]},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": ["string", "null"]},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "name", "source_path", "snapshot_ref", "sha256", "mode", "label", "preflight", "source_cleanliness", "composition_contract", "iso_profile", "installer_plan_disk_mib"],
      "properties": {
        "schema_version": {"const": 1},
        "name": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "snapshot_ref": {"const": "build-config.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mode": {"enum": ["development", "release_candidate"]},
        "label": {"type": ["string", "null"]},
        "preflight": {"enum": ["standard", "full", "skip"]},
        "source_cleanliness": {"enum": ["require_clean", "allow_dirty"]},
        "composition_contract": {"const": "portusos-build/contracts/build.yaml"},
        "iso_profile": {"const": "portusos-build/iso/profile.yaml"},
        "installer_plan_disk_mib": {"type": "integer", "minimum": 40960, "maximum": 1048576}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "short_revision", "branch", "tree_clean", "reproducible_source", "dirty_status"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "short_revision": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "branch": {"type": "string", "minLength": 1},
        "tree_clean": {"type": "boolean"},
        "reproducible_source": {"type": "boolean"},
        "dirty_status": {"type": "array", "items": {"type": "string"}}
      }
    },
    "outer_host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "architecture", "kernel_release", "distribution_id", "distribution_version", "distribution_pretty_name", "git_version", "rustc_version", "cargo_version"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "kernel_release": {"type": "string", "minLength": 1},
        "distribution_id": {"type": ["string", "null"]},
        "distribution_version": {"type": ["string", "null"]},
        "distribution_pretty_name": {"type": ["string", "null"]},
        "git_version": {"type": ["string", "null"]},
        "rustc_version": {"type": ["string", "null"]},
        "cargo_version": {"type": ["string", "null"]}
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_required", "environment_result", "skipped", "full"],
      "properties": {
        "environment_required": {"const": true},
        "environment_result": {"type": ["string", "null"], "enum": ["pass", "warn", "block", null]},
        "skipped": {"type": "boolean"},
        "full": {"type": "boolean"}
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "started_at", "finished_at", "exit_code"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "started_at": {"type": "string", "minLength": 1},
          "finished_at": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}
        }
      }
    },
    "artifact": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["relative_path", "filename", "sha256", "size_bytes"],
          "properties": {
            "relative_path": {"type": "string", "minLength": 1},
            "filename": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "size_bytes": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "failure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "reason", "exit_code"],
          "properties": {
            "stage": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1},
            "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}
          }
        }
      ]
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_config", "build_config_sha256", "environment_preflight", "log", "inputs", "contract_report", "build_plan", "staging_evidence", "native_build_result", "native_cleanup", "run_sha256sums"],
      "properties": {
        "log": {"type": "string", "minLength": 1},
        "build_config": {"const": "build-config.json"},
        "build_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environment_preflight": {"const": "preflight.json"},
        "environment_preflight_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inputs": {"type": "string", "minLength": 1},
        "contract_report": {"type": "string", "minLength": 1},
        "build_plan": {"type": "string", "minLength": 1},
        "staging_evidence": {"const": "staging-evidence.json"},
        "staging_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "native_build_result": {"const": "native-build-result.json"},
        "native_build_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "native_cleanup": {"const": "native-cleanup.json"},
        "native_cleanup_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_sha256sums": {"type": ["string", "null"]},
        "inputs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
