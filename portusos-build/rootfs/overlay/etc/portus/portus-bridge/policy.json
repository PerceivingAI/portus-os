{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PortusBridgePolicy",
  "version": "2.0",
  "workspace": {
    "projects": {},
    "enforce_boundary": true,
    "allow_hidden_files": false,
    "denied_paths": [
      ".git",
      ".env",
      ".env.*",
      "*.local.json",
      "**/*.pem",
      "**/*.key"
    ]
  },
  "permissions": {
    "read_only": false,
    "tools": {
      "read_file": true,
      "write_file": true,
      "patch_file": true,
      "search_codebase": true,
      "list_directory": true,
      "exec_command": true,
      "git_status_diff": true,
      "load_instructions": true
    }
  },
  "execution": {
    "mode": "filtered",
    "max_timeout_seconds": 30,
    "allowed_command_patterns": [
      "^cargo (check|test|build|clippy)",
      "^npm (test|run|install|build)",
      "^pnpm (test|run|install|build)",
      "^git (status|diff|log|branch)"
    ],
    "denied_command_patterns": [
      "rm -rf /",
      ":\\(\\)\\{ :\\|:& \\};:",
      "mkfs",
      "dd if=/dev/zero",
      "shutdown",
      "reboot"
    ]
  },
  "codex_ingestion": {
    "enabled": true,
    "ingest_codexpolicy": true,
    "ingest_codex_permissions": true
  }
}
