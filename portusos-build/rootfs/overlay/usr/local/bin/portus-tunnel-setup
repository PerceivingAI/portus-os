#!/usr/bin/env bash
set -euo pipefail

mcp_root=/opt/portus/portus-mcp
current_user=${USER:-$(id -un)}
workspace="/workspace/${current_user}/master"
state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/portus-mcp"
profile_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/tunnel-client"
profile=portus-local
profile_path="$profile_dir/$profile.yaml"
policy=/etc/portus/portus-mcp/policy.json
mcp_url=http://127.0.0.1:8789/mcp

for program in tunnel-client npm node; do
  if ! command -v "$program" >/dev/null 2>&1; then
    echo "portus-tunnel-setup: required program is unavailable: $program" >&2
    exit 69
  fi
done
if [[ ! -d "$mcp_root" ]]; then
  echo "portus-tunnel-setup: bundled Portus MCP payload is missing: $mcp_root" >&2
  exit 69
fi
if [[ ! -d "$workspace" ]]; then
  echo "portus-tunnel-setup: Master workspace is missing: $workspace" >&2
  echo "Run portus-bootstrap first." >&2
  exit 69
fi
if [[ ! -f "$policy" || ! -f "$mcp_root/node_modules/tsx/dist/cli.mjs" ]]; then
  echo "portus-tunnel-setup: PortusOS MCP policy or dependency payload is incomplete" >&2
  exit 69
fi

mkdir -p "$state_dir" "$profile_dir"

if [[ -z "${CONTROL_PLANE_API_KEY:-}" ]]; then
  read -r -s -p "OpenAI tunnel runtime API key: " CONTROL_PLANE_API_KEY
  echo
  if [[ -z "$CONTROL_PLANE_API_KEY" ]]; then
    echo "portus-tunnel-setup: API key cannot be empty" >&2
    exit 64
  fi
  export CONTROL_PLANE_API_KEY
fi

if [[ ! -f "$profile_path" ]]; then
  read -r -p "OpenAI tunnel ID: " CONTROL_PLANE_TUNNEL_ID
  if [[ -z "$CONTROL_PLANE_TUNNEL_ID" ]]; then
    echo "portus-tunnel-setup: tunnel ID cannot be empty" >&2
    exit 64
  fi
  tunnel-client init \
    --profile-dir "$profile_dir" \
    --profile "$profile" \
    --tunnel-id "$CONTROL_PLANE_TUNNEL_ID" \
    --mcp-server-url "$mcp_url"
else
  echo "Using existing tunnel profile: $profile_path"
fi

tunnel-client codex plugin install

export TUNNEL_CLIENT_PROFILE_DIR="$profile_dir"
export PORTUS_TUNNEL_CLIENT_PATH=/usr/local/bin/tunnel-client
export PORTUS_TUNNEL_PROFILE="$profile"
export PORTUS_MCP_HOST=127.0.0.1
export PORTUS_MCP_PORT=8789
export PORTUS_MCP_PATH=/mcp
export PORTUS_MCP_POLICY_PATH="$policy"
export PORTUS_MCP_STATE_DIR="$state_dir"
export PORTUS_MCP_PROJECTS="master=$workspace"
export AGENT_SKILL_PATHS="$mcp_root/skills"
export SUBAGENTS_SKILL_PATHS=

cat <<'EOF'
Starting Portus MCP + Secure MCP Tunnel.
The runtime API key is session-scoped and is not written into the PortusOS image.
Press Ctrl+C once to stop both processes cleanly.
EOF

cd "$mcp_root"
exec npm run start:tunnel
